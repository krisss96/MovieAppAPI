        {
          "name": "Save movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Interstellar\",\n  \"mins\": 169,\n  \"rating\": 8.6,\n  \"platform\": {\n    \"name\": \"Netflix\",\n    \"imagePath\": \"/images/platforms/netflix.png\"\n  },\n  \"mood\": {\n    \"name\": \"hopeful\"\n  },\n  \"feelings\": [\n    {\n      \"feeling\": \"awe\"\n    },\n    {\n      \"feeling\": \"wonder\"\n    }\n  ],\n  \"quote\": \"Love is the one thing we're capable of perceiving that transcends dimensions of time and space.\",\n  \"color1\": 12,\n  \"color2\": 34,\n  \"color3\": 56,\n  \"color4\": 78,\n  \"color5\": 90,\n  \"heroImage\": \"/images/interstellar/hero.jpg\",\n  \"soundtrack\": \"/audio/interstellar.mp3\",\n  \"scene1\": \"/images/interstellar/scene1.jpg\",\n  \"scene2\": \"/images/interstellar/scene2.jpg\",\n  \"scene3\": \"/images/interstellar/scene3.jpg\",\n  \"scene4\": \"/images/interstellar/scene4.jpg\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finder/api/movies/save",
              "host": ["{{baseUrl}}"],
              "path": ["finder", "api", "movies", "save"]
            }
          }
        },
        {
          "name": "Delete movie",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
