              "raw": "{\n  \"title\": \"Interstellar\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finder/api/movies/delete",
              "host": ["{{baseUrl}}"],
              "path": ["finder", "api", "movies", "delete"]
            }
